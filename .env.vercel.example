# Vercel Deployment Environment Variables
# ==========================================
#
# REQUIRED: Only one environment variable needed for deployment!
#
# GTFS_DATA_URL - URL to download GTFS data in .zip format
# Example: https://example.com/gtfs-data.zip
GTFS_DATA_URL=

# OPTIONAL: Override these if you need custom URLs
# By default, these are auto-derived from VERCEL_URL
#
# NEXT_PUBLIC_API_BASE_URL=https://your-domain.vercel.app/api
# NEXT_PUBLIC_BASE_URL=https://your-domain.vercel.app
# CORS_ORIGINS=https://your-domain.vercel.app

# OPTIONAL: Enable basic auth for staging/preview deployments
# ENABLE_BASIC_AUTH=false
# BASIC_AUTH_USERNAME=
# BASIC_AUTH_PASSWORD=
