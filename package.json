{
  "name": "gtfs-jp-wayfinder",
  "version": "0.0.1",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "turbo run dev",
    "dev:network": "turbo run dev:network",
    "start": "turbo run start",
    "build": "turbo run build",
    "build:vercel": "cd api && uv sync --no-dev && uv run --no-sync python scripts/build_graph.py && node -e \"require('fs').rmSync('.venv',{ recursive: true, force: true })\" && cd ../web && pnpm build && node -e \"require('fs').rmSync('.next/cache',{ recursive: true, force: true })\"",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "prepush": "turbo run lint",
    "openapi-generate": "node ./scripts/generate-openapi.js",
    "storybook": "pnpm --filter web storybook",
    "build-storybook": "pnpm --filter web build-storybook",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "git config core.hooksPath .githooks || true",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.14.0",
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.83.1",
    "concurrently": "^9.2.1",
    "next": "15.5.9",
    "turbo": "^2.5.6"
  }
}