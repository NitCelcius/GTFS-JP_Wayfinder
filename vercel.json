{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/:path*",
      "destination": "/web/:path*"
    }
  ],
  "functions": {
    "api/index.py": {
      "runtime": "python3.12",
      "maxDuration": 60,
      "includeFiles": "api/**"
    }
  },
  "installCommand": "cd web && pnpm install",
  "buildCommand": "cd web && pnpm build",
  "devCommand": "cd web && pnpm dev",
  "outputDirectory": "web/.next"
}